{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "entryPoints": ["./src/index.ts"],
  "tsconfig": "./tsconfig.json",
  "name": "wapi.js",
  "plugin": ["typedoc-plugin-markdown"],
  "fileExtension": ".mdx",
  "readme": "none",
  "out": "../../apps/docs/api-reference",
  "sourceLinkTemplate": "https://github.com/wapikit/wapi.js/blob/{gitRevision}/{path}#L{line}",
  "hideGenerator": true,
  "hidePageHeader": true,
  "excludePrivate": true,
  "excludeInternal": true
}
