{
  "name": "@wapijs/wapi.js",
  "version": "0.1.1",
  "description": "TypeScript SDK for the WhatsApp Cloud API: send every message type, receive webhooks on any server, manage templates, phone numbers and catalogs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "clean": "rm -rf ./dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test --max-warnings=0",
    "pretty": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "clean-install": "rm -rf ./node_modules && pnpm install --frozen-lockfile",
    "doc:gen": "typedoc"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-cloud-api",
    "whatsapp-business-api",
    "whatsapp-bot",
    "whatsapp-chat-bot",
    "chat-bot",
    "wapikit"
  ],
  "author": {
    "name": "Sarthak Jain",
    "url": "https://sarthakjdev.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wapikit/wapi.js.git",
    "directory": "packages/wapi.js"
  },
  "bugs": {
    "url": "https://github.com/wapikit/wapi.js/issues"
  },
  "homepage": "https://javascript.wapikit.com",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.5.9",
    "@wapijs/eslint-config": "workspace:*",
    "@wapijs/prettier-config": "workspace:*",
    "@wapijs/typescript-config": "workspace:*",
    "prettier": "^3.0.3",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.2.10",
    "typescript": "5.4.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
